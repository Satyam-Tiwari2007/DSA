class Solution {
public:
    vector<int> findDuplicates(vector<int>& nums) {
        int n = nums.size();
        vector<int> arr(n+1,0);

        for(int i = 0;i<nums.size();i++){
            arr[nums[i]]++;

        }
        vector<int> ans;
        for(int i =1;i<arr.size();i++){
            if(arr[i]>1){
                ans.push_back(i);
            }
        }
        return ans;
    }
};
