class Solution {
public:
    int longestMonotonicSubarray(vector<int>& nums) {
        int maxlength = 1;
        int inclength =1;
        int declength=1;
        int i =1;
        while(i<nums.size()){
            if(nums[i]>nums[i-1]){
                inclength++;
                declength = 1;
            }
            else if(nums[i]<nums[i-1]){
                declength++;
                inclength = 1;
            }else{
                inclength=1;
                declength=1;
            }
            maxlength = max(maxlength, max(inclength, declength));
            i++;

        }
        
        return maxlength;
    }
};
