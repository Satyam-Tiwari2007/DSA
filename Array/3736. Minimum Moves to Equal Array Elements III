class Solution {
public:
    int minMoves(vector<int>& nums) {
        int maxi = INT_MIN;
        for(int i =0;i<nums.size();i++){
            maxi = max(maxi,nums[i]);
        }
        int diff = 0;
        int ans = 0;
        for(int i =0;i<nums.size();i++){
            diff = maxi - nums[i];
            ans = ans + diff;
        }
        return ans;
    }
};
