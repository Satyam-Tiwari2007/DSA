class Solution {
public:
    long long mink(vector<int>&piles,int speed){
        long long sum=0;
        for(int i:piles){
            sum += (i+speed-1)/speed ;
        }
        return sum;
    }
    int minEatingSpeed(vector<int>& piles, int h) {
        int low =1;
        int high = *max_element(piles.begin(),piles.end());
        int speed=-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(mink(piles,mid)<=h){
                speed=mid;
                high=mid-1;
            }else{
                low=mid+1;
            }
        }
        return speed;
    }
};
