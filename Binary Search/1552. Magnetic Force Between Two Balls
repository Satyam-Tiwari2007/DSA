class Solution {
public:
    bool ispossible(vector<int>& position,int mid, int m){
        int cntball = 1;
        int last=position[0];
        for(int i=1;i<position.size();i++){
            if(position[i]-last>=mid){
                cntball++;
                last=position[i];
            }
        }
        if(cntball>=m){
            return true;
        }
        return false;

    }
    int maxDistance(vector<int>& position, int m) {
        sort(position.begin(),position.end());
        int n=position.size()-1;
        int low =0;
        int high = position[n]-position[0];
        int ans=0;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(ispossible(position,mid,m)==true){
                ans=mid;
                low=mid+1;
            }else{
                high=mid-1;
            }
        }
        return ans;
    }
};
