class Solution {
public:
    int  NoOfSubarray(vector<int>& nums, int mid){
        int subarr =1; int sum=0;
        for(int i=0;i<nums.size();i++){
            sum += nums[i];
            if(sum>mid){
               subarr++;
               sum=nums[i];
            }
        }
        return subarr;
    }
    int splitArray(vector<int>& nums, int k) {
        int low = *max_element(nums.begin(),nums.end());
        int high = accumulate(nums.begin(),nums.end(),0);
        int ans =0;
        while(low<=high){
            int mid = low+(high-low)/2;
            int subarrCnt = NoOfSubarray(nums,mid);
            if(subarrCnt<=k){
                ans=mid;
                high=mid-1;
            }else{
                low=mid+1;
            }
        }
        return ans;
    }
};
