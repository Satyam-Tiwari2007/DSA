#include <bits/stdc++.h>
using namespace std;
class solution{
    public:
    int lowerBound (vector<int> nums,int x){
        int low = 0;
        int high = nums.size()-1;
        int ans = nums.size()-1;
        while(low<=high){
            
            int mid = low + (high - low)/2;
            if(nums[mid]>=x){
                ans = mid;
                high = mid-1;
            }
            else{
                low = mid+1;
            }
            
        }
        return ans;
    }
};
int main() {
    // Write C++ code here

     vector<int> arr = {2, 3, 7, 10, 11, 11, 25};
    int x = 30;
 
    solution obj;
    cout << obj.lowerBound(arr, x) << endl;
 
    return 0;
}
