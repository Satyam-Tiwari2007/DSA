class Solution {
public:
    int sumDiviser(vector<int>& nums,int diviser){
        int n = nums.size();
        int sum =0;
        for(int i =0;i<n;i++){
            sum = sum + ceil((double)nums[i]/(double)diviser);
        }
        return sum;
    }
    int smallestDivisor(vector<int>& nums, int threshold) {
        int low = 1;
        int high = *max_element(nums.begin(),nums.end());
        int smallest = 0;
        while(low<=high){
            int mid = low+(high-low)/2;
            if(sumDiviser(nums,mid)<=threshold){
                smallest = mid;
                high = mid-1;
            }else{
                low = mid+1;
            }
        }
        return smallest;
    }
};
