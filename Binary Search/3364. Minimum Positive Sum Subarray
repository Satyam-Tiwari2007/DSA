class Solution {
public:
    int minimumSumSubarray(vector<int>& nums, int l, int r) {
        int n = nums.size();
        vector<int>prefix(n+1,0);
        for(int i=0;i<n;i++){
            prefix[i+1]=prefix[i]+nums[i];
        }
        int mini = INT_MAX;
        for(int len=l;len<=r;len++){
            for(int i=0;i+len<=n;i++){
                int sum=prefix[i+len]-prefix[i];
                if(sum>0){
                    mini=min(mini,sum);
                }

            }
        }
        return mini==INT_MAX?-1:mini;
    }
};
