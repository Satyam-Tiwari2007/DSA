class Solution {
public:
    int maxProduct(int n) {

        // Stores the largest digit found so far
        int firstMax = 0;

        // Stores the second largest digit found so far
        int secondMax = 0;

        // Traverse every digit of the number
        while (n > 0) {

            // Extract the last digit
            int digit = n % 10;

            // If current digit is larger than the largest digit
            if (digit > firstMax) {

                // Old largest becomes second largest
                secondMax = firstMax;

                // Update largest
                firstMax = digit;
            }

            // Otherwise, check if it should become the second largest
            else if (digit > secondMax) {
                secondMax = digit;
            }

            // Remove the last digit
            n /= 10;
        }

        // Return the product of the two largest digits
        return firstMax * secondMax;
    }
};


class Solution {
public:
    // Function to check if a number is prime
    bool isPrime(long long num) {

        // Numbers less than 2 are not prime
        if (num < 2) return false;

        // Check divisibility up to sqrt(num)
        for (long long i = 2; i * i <= num; i++) {
            if (num % i == 0)
                return false;
        }

        return true;
    }

    long long sumOfLargestPrimes(string s) {

        // Store only unique prime numbers
        unordered_set<long long> primes;

        int n = s.size();

        // Generate all possible substrings
        for (int i = 0; i < n; i++) {

            long long num = 0;

            for (int j = i; j < n; j++) {

                // Build the current number digit by digit
                num = num * 10 + (s[j] - '0');

                // If it is prime, store it
                if (isPrime(num))
                    primes.insert(num);
            }
        }

        // Move primes into a vector
        vector<long long> arr(primes.begin(), primes.end());

        // Sort in descending order
        sort(arr.begin(), arr.end(), greater<long long>());

        long long ans = 0;

        // Sum the largest 3 primes (or fewer if less than 3 exist)
        for (int i = 0; i < min(3, (int)arr.size()); i++) {
            ans += arr[i];
        }

        return ans;
    }
};



class Solution {
public:
    int missingMultiple(vector<int>& nums, int k) {
        unordered_set<int> st(nums.begin(), nums.end());

        int multiple = k;

        while (st.count(multiple)) {
            multiple += k;
        }

        return multiple;
    }
};



class Solution {
public:
    int strStr(string haystack, string needle) {
        int m = haystack.size();
        int n = needle.size();
        for(int i=0;i<=m-n;i++){
            int j =0;
            while(j<n&&haystack[i+j]==needle[j]){
                j++;
            }
            if(j==n){
                return i;
            }
        }
        return -1;
        
    }
};


2948. Make Lexicographically Smallest Array by Swapping Elements
class Solution {
public:
    vector<int> lexicographicallySmallestArray(vector<int>& nums, int limit) {
        int n = nums.size();

        vector<pair<int, int>> a;

        for (int i = 0; i < n; i++)
            a.push_back({nums[i], i});

        sort(a.begin(), a.end());

        vector<int> ans = nums;

        int i = 0;

        while (i < n) {
            int j = i;

            while (j + 1 < n &&
                   a[j + 1].first - a[j].first <= limit)
                j++;

            vector<int> pos;

            for (int k = i; k <= j; k++)
                pos.push_back(a[k].second);

            sort(pos.begin(), pos.end());

            for (int k = 0; k < pos.size(); k++)
                ans[pos[k]] = a[i + k].first;

            i = j + 1;
        }

        return ans;
    }
};





/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    vector<int> nodesBetweenCriticalPoints(ListNode* head) {
        int first = -1;
        int last = -1;
        int minDist = INT_MAX;

        ListNode* prev = head;
        ListNode* curr = head->next;
        int index = 1;

        while (curr->next) {
            if ((curr->val > prev->val && curr->val > curr->next->val) ||
                (curr->val < prev->val && curr->val < curr->next->val)) {

                if (first == -1) {
                    first = index;
                } else {
                    minDist = min(minDist, index - last);
                }

                last = index;
            }

            prev = curr;
            curr = curr->next;
            index++;
        }

        if (first == -1 || first == last)
            return {-1, -1};

        return {minDist, last - first};
    }
};




class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n = nums.size();

        vector<int> right(n);
        right[n - 1] = nums[n - 1];

        for (int i = n - 2; i >= 0; i--) {
            right[i] = min(right[i + 1], nums[i]);
        }

        int left = 0;

        for (int i = 0; i < n; i++) {
            left = max(left, nums[i]);

            if (left - right[i] <= k) {
                return i;
            }
        }

        return -1;
    }
}



