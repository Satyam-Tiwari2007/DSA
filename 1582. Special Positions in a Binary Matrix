class Solution {
public:
    int numSpecial(vector<vector<int>>& mat) {
        int n = mat.size();
        int m = mat[0].size();
        vector<int>rowcnt(n,0);
        vector<int>colcnt(m,0);
        int ans =0;
        for(int i = 0;i<n;i++){
            for(int j =0;j<m;j++){
                if(mat[i][j]==1){
                    rowcnt[i]++;
                    colcnt[j]++;
                }
            }
        }

        for(int i =0;i<n;i++){
            for(int j =0;j<m;j++){
                if(mat[i][j]==0)continue;
                if(rowcnt[i]==1 && colcnt[j]==1){
                    ans++;
                }
            }
        }

        return ans;
    }
};
